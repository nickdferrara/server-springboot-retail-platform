root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
ktlint_code_style = ktlint_official

# package-info.kt holds the Spring Modulith module declaration for its package.
[**/package-info.kt]
ktlint_standard_filename = disabled

# Inbound adapters live in `adapter.in`, which Kotlin spells with backticks because `in` is a keyword.
[**/adapter/in/**/*.kt]
ktlint_standard_package-name = disabled

[*.{yaml,yml,toml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
